#!/bin/sh
# Advance the ?v= cache markers for whatever is staged, then stage the result.
#
# GitHub Pages caches for ten minutes, so a module whose marker did not move is
# served stale beside one that did. Doing this by hand failed three times in a
# single session, each time producing a fix that looked broken because the
# browser never loaded it.
set -e

# Stage exactly the files the bumper rewrote, so nothing else the author left
# unstaged is swept in. Matching them with a glob instead missed
# data/VERSION.json, which the bumper also writes: every commit then recorded a
# build one behind the shell it shipped, and the working tree never came clean.
changed=$(node tools/bump_cache_versions.mjs --print-changed)

if [ -n "$changed" ]; then
  printf '%s\n' "$changed" | while IFS= read -r file; do
    if [ -n "$file" ] && [ -f "$file" ]; then
      git add -- "$file"
    fi
  done
fi
